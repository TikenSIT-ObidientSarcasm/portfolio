@model portfolio.Models.Course
@using portfolio.Models

@{
    ViewData["Title"] = Model.course_name;
    var projects = ViewBag.Projects as List<Project>
                   ?? new List<Project>();
}

<div class="portfolio-page">

    <a asp-action="Index" class="back-link">← Back to Courses</a>

    <div class="details-header">
        <div class="section-label">COURSE DETAILS</div>
        <h1>@Model.course_name</h1>
        <p>@Model.course_code</p>
    </div>

    <section class="details-section">
        <h2>About This Course</h2>
        <p>@(Model.description ?? "No description provided.")</p>
    </section>

    <section class="details-section">

        <div class="section-heading">
            <div>
                <div class="section-label">CONNECTED WORK</div>
                <h2>Associated Projects</h2>
            </div>

            <span class="text-muted">
                @projects.Count project(s)
            </span>
        </div>

        <div class="project-grid">

            @if (projects.Any())
            {
                foreach (var project in projects)
                {
                    <article class="project-card">
                        <div class="project-card-body">

                            <h3>@project.project_title</h3>

                            <p>
                                @(project.description ?? "No description provided.")
                            </p>

                            <a asp-controller="Project"
                               asp-action="Details"
                               asp-route-id="@project.project_id"
                               class="project-link">
                                View Project →
                            </a>

                        </div>
                    </article>
                }
            }
            else
            {
                <div class="empty-projects">
                    <h3>No connected projects</h3>
                    <p>Projects assigned to this course will appear here.</p>
                </div>
            }

        </div>
    </section>

    <div class="details-actions">
        <a asp-action="Edit"
           asp-route-id="@Model.course_id"
           class="btn-primary-custom">
            Edit Course
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.course_id"
           class="btn-danger-custom">
            Delete Course
        </a>
    </div>

</div>
