@model portfolio.Models.Course

@{
    ViewData["Title"] = "Edit a Course";
}

<h1 class="mb-3">Edit a Course</h1>

<form asp-action="Edit" method="post"
      class="card card-body" style="max-width:36rem">

    <input type="hidden" asp-for="course_id" />

    <div class="mb-3">
        <label asp-for="course_code" class="form-label">Course Code</label>
        <input asp-for="course_code" class="form-control" />
        <span asp-validation-for="course_code" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="course_name" class="form-label">Course Name</label>
        <input asp-for="course_name" class="form-control" />
        <span asp-validation-for="course_name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="description" class="form-label">Description</label>
        <textarea asp-for="description" class="form-control"
                  rows="4"></textarea>
        <span asp-validation-for="description" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
