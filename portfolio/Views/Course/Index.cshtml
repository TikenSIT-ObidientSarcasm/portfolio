@model List<portfolio.Models.Course>
@using portfolio.Models

@{
    ViewData["Title"] = "Courses";

    // True only when the editor is logged in
    var isEditor = User.Identity?.IsAuthenticated == true;

    var projectCounts = ViewBag.ProjectCounts as Dictionary<long, int>
                        ?? new Dictionary<long, int>();

    var courseProjects = ViewBag.CourseProjects as Dictionary<long, List<Project>>
                         ?? new Dictionary<long, List<Project>>();
}

<div class="portfolio-page">

    <section class="hero">
        <div class="eyebrow">ACADEMIC COLLECTION</div>
        <h1>Courses.</h1>
        <p>
            Browse the courses connected to my projects and academic work.
        </p>
    </section>

    <section class="section">

        <div class="section-heading">
            <div>
                <div class="section-label">COURSE DIRECTORY</div>
                <h2>All Courses</h2>
                <p class="text-muted mb-0 mt-2">
                    @(Model?.Count ?? 0) course(s) available
                </p>
            </div>

            @if (isEditor)
            {
                <button type="button" class="btn-primary-custom"
                        data-bs-toggle="modal" data-bs-target="#addCourseModal">
                    + Add Course
                </button>
            }
        </div>

        <div class="course-grid">

            @if (Model != null && Model.Any())
            {
                foreach (var course in Model)
                {
                    var count = projectCounts.ContainsKey(course.course_id)
                        ? projectCounts[course.course_id]
                        : 0;

                    <article class="course-card"
                             data-course-modal="#courseModal-@course.course_id"
                             tabindex="0">
                        <div class="course-card-body">

                            <div class="course-code">
                                @course.course_code
                            </div>

                            <h3>@course.course_name</h3>

                            <p>
                                @(string.IsNullOrWhiteSpace(course.description)
                                    ? "No course description provided."
                                    : course.description)
                            </p>

                            <div class="course-project-count">
                                @count connected project(s)
                            </div>

                            @if (isEditor)
                            {
                                <div class="project-actions">
                                    <button type="button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editCourseModal-@course.course_id">
                                        Edit
                                    </button>

                                    <button type="button"
                                            class="delete-link"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteCourseModal-@course.course_id">
                                        Delete
                                    </button>
                                </div>
                            }

                        </div>
                    </article>
                }
            }
            else
            {
                <div class="empty-projects">
                    <h3>No courses yet</h3>

                    @if (isEditor)
                    {
                        <p>Added courses will appear here.</p>

                        <button type="button" class="btn-primary-custom"
                                data-bs-toggle="modal" data-bs-target="#addCourseModal">
                            Add Your First Course
                        </button>
                    }
                    else
                    {
                        <p>Check back soon.</p>
                    }
                </div>
            }

        </div>
    </section>
</div>

@* ===== COURSE DETAILS POPUPS: projects in each course (everyone) ===== *@
@if (Model != null && Model.Any())
{
    foreach (var course in Model)
    {
        var projects = courseProjects.ContainsKey(course.course_id)
            ? courseProjects[course.course_id]
            : new List<Project>();

        <div class="modal fade" id="courseModal-@course.course_id"
             tabindex="-1"
             aria-labelledby="courseModalLabel-@course.course_id"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <div>
                            <div class="project-number">@course.course_code</div>
                            <h5 class="modal-title"
                                id="courseModalLabel-@course.course_id">
                                @course.course_name
                            </h5>
                        </div>

                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal" aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body">

                        @if (!string.IsNullOrWhiteSpace(course.description))
                        {
                            <p style="white-space: pre-line;">@course.description</p>
                        }

                        <div class="section-label mb-3">
                            CONNECTED PROJECTS (@projects.Count)
                        </div>

                        @if (projects.Any())
                        {
                            foreach (var p in projects)
                            {
                                <div class="course-project-item">
                                    <h6>@p.project_title</h6>

                                    <p class="text-muted mb-0">
                                        @(string.IsNullOrWhiteSpace(p.description)
                                            ? "No description provided."
                                            : p.description)
                                    </p>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="project-modal-placeholder">
                                No projects in this course yet.
                            </div>
                        }

                    </div>

                    <div class="modal-footer">
                        <a asp-controller="Project" asp-action="Index"
                           class="btn btn-outline-secondary">
                            Go to Projects
                        </a>

                        <button type="button" class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Close
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }
}

@* ===== PER-COURSE EDIT AND DELETE POPUPS (editor only) ===== *@
@if (isEditor && Model != null && Model.Any())
{
    foreach (var course in Model)
    {
        var count = projectCounts.ContainsKey(course.course_id)
            ? projectCounts[course.course_id]
            : 0;

        @* ---------- EDIT POPUP ---------- *@
        <div class="modal fade" id="editCourseModal-@course.course_id"
             tabindex="-1"
             aria-labelledby="editCourseLabel-@course.course_id"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">

                    <form asp-controller="Course" asp-action="Edit" method="post">

                        <div class="modal-header">
                            <h5 class="modal-title"
                                id="editCourseLabel-@course.course_id">
                                Edit Course
                            </h5>

                            <button type="button" class="btn-close"
                                    data-bs-dismiss="modal" aria-label="Close">
                            </button>
                        </div>

                        <div class="modal-body">

                            <input type="hidden" name="course_id"
                                   value="@course.course_id" />

                            <div class="mb-3">
                                <label for="edit-code-@course.course_id"
                                       class="form-label">Course Code</label>
                                <input id="edit-code-@course.course_id"
                                       name="course_code"
                                       value="@course.course_code"
                                       class="form-control"
                                       required minlength="2" maxlength="30" />
                            </div>

                            <div class="mb-3">
                                <label for="edit-name-@course.course_id"
                                       class="form-label">Course Name</label>
                                <input id="edit-name-@course.course_id"
                                       name="course_name"
                                       value="@course.course_name"
                                       class="form-control"
                                       required minlength="2" />
                            </div>

                            <div class="mb-3">
                                <label for="edit-desc-@course.course_id"
                                       class="form-label">Description</label>
                                <textarea id="edit-desc-@course.course_id"
                                          name="description"
                                          class="form-control"
                                          rows="4">@course.description</textarea>
                            </div>

                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <button type="submit" class="btn btn-primary">
                                Save Changes
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>

        @* ---------- DELETE POPUP ---------- *@
        <div class="modal fade" id="deleteCourseModal-@course.course_id"
             tabindex="-1"
             aria-labelledby="deleteCourseLabel-@course.course_id"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title"
                            id="deleteCourseLabel-@course.course_id">
                            Delete Course
                        </h5>

                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal" aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body">
                        <p>
                            Are you sure you want to delete
                            <strong>@course.course_code · @course.course_name</strong>?
                        </p>

                        @if (count > 0)
                        {
                            <p class="text-danger mb-0">
                                This course has @count connected project(s),
                                so it cannot be deleted until they are removed
                                or moved to another course.
                            </p>
                        }
                        else
                        {
                            <p class="text-muted small mb-0">
                                This permanently deletes the course and cannot be undone.
                            </p>
                        }
                    </div>

                    <div class="modal-footer">
                        <form asp-controller="Course" asp-action="Delete"
                              asp-route-id="@course.course_id"
                              method="post">

                            <button type="button" class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <button type="submit" class="btn btn-danger">
                                Delete
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    }
}

@* Editor only: the Add Course modal is not sent to viewers at all *@
@if (isEditor)
{
    <!-- Add Course Modal -->
    <div class="modal fade" id="addCourseModal" tabindex="-1"
         aria-labelledby="addCourseModalLabel" aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="addCourseModalLabel">
                        Add a Course
                    </h5>

                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <partial name="Create" model="new portfolio.Models.Course()" />
                </div>

            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Clicking a course card opens its projects popup, unless the click
        // was on the Edit / Delete buttons. Enter or Space works too.
        document.querySelectorAll('.course-card[data-course-modal]')
            .forEach(function (card) {
                function openDetails() {
                    var modalEl = document.querySelector(card.dataset.courseModal);
                    if (modalEl) {
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    }
                }

                card.addEventListener('click', function (e) {
                    if (e.target.closest('button, a')) return;
                    openDetails();
                });

                card.addEventListener('keydown', function (e) {
                    if ((e.key === 'Enter' || e.key === ' ') && e.target === card) {
                        e.preventDefault();
                        openDetails();
                    }
                });
            });
    </script>
}