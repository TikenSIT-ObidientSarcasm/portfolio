<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Portfolio</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/portfolio.styles.css" asp-append-version="true" />
</head>

<body>
    @* Loading screen: shown once per visit. This tiny script hides it
       on later pages so it doesn't replay on every click. *@
    <script>
            try {
                if (sessionStorage.getItem('booted')) {
                    document.documentElement.classList.add('no-boot');
                }
            } catch (e) { }
    </script>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg portfolio-nav">
            <div class="container">
                <a class="navbar-brand portfolio-brand"
                   asp-controller="Project"
                   asp-action="Index">
                    PORTFOLIO<span>.</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#portfolioNavigation"
                        aria-controls="portfolioNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="portfolioNavigation">

                    <div class="navbar-nav ms-auto align-items-lg-center">
                        <a class="nav-link"
                           asp-controller="Project"
                           asp-action="Index">
                            Projects
                        </a>

                        <a class="nav-link"
                           asp-controller="Course"
                           asp-action="Index">
                            Courses
                        </a>

                        @* Editor only: viewers don't see these *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="nav-link"
                               asp-controller="ProjectImage"
                               asp-action="Index">
                                Project Images
                            </a>

                            <form asp-controller="Account" asp-action="Logout"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav-link btn btn-link">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">
                                Editor Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <span>PORTFOLIO.</span>
            <span>Projects, courses, and creative work.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>