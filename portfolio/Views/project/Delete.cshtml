@model portfolio.Models.Project

@{
    ViewData["Title"] = "Delete a Project";
}

<h1 class="mb-3">Delete a Project</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card card-body" style="max-width:36rem">

    <p>Are you sure you want to delete this course?</p>

    <dl class="row mb-3">

        <dt class="col-4">ID</dt>
        <dd class="col-8">@Model.project_id</dd>

        <dt class="col-4">Project Title</dt>
        <dd class="col-8">@Model.project_title</dd>

        <dt class="col-4">Description</dt>
        <dd class="col-8">@(Model.description ?? "—")</dd>

        <dt class="col-4">video_url</dt>
        <dd class="col-8">@Model.video_url</dd>

    </dl>

    <p class="text-muted small">
        This action permanently deletes the project.
        Projects with existing entries cannot be deleted.
    </p>

    <form asp-action="Delete"
          asp-route-id="@Model.project_id"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>

    </form>
</div>
