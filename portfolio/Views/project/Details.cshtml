@model portfolio.Models.Project
@using portfolio.Models

@{
    ViewData["Title"] = Model.project_title;

    var images = ViewBag.Images as List<ProjectImage>
                 ?? new List<ProjectImage>();

    var course = ViewBag.Course as Course;
}

<div class="portfolio-page">

    <section class="hero">
        <div class="eyebrow">PROJECT DETAILS</div>

        <h1>@Model.project_title.</h1>

        <p>
            @(string.IsNullOrWhiteSpace(Model.description)
                ? "No description provided."
                : Model.description)
        </p>

        @if (course != null)
        {
            <div class="project-course">
                @course.course_code
            </div>
        }
    </section>

    <section class="section">

        <div class="section-heading">
            <div>
                <div class="section-label">PROJECT GALLERY</div>
                <h2>Project Images</h2>

                <p class="text-muted mt-2">
                    @images.Count image(s)
                </p>
            </div>

            <a asp-controller="ProjectImage"
               asp-action="Create"
               asp-route-projectId="@Model.project_id"
               class="btn-primary-custom">
                + Add Image
            </a>
        </div>

        <div class="image-gallery">

            @if (images.Any())
            {
                foreach (var image in images)
                {
                    <article class="image-card">

                        <img src="@image.image_url"
                             alt="@Model.project_title" />

                        <div class="image-card-info">

                            <div class="project-actions">

                                <a asp-controller="ProjectImage"
                                   asp-action="Edit"
                                   asp-route-id="@image.image_id">
                                    Edit
                                </a>

                                <a asp-controller="ProjectImage"
                                   asp-action="Delete"
                                   asp-route-id="@image.image_id"
                                   class="delete-link">
                                    Delete
                                </a>

                            </div>

                        </div>

                    </article>
                }
            }
            else
            {
                <div class="empty-projects">
                    <h3>No images yet</h3>
                    <p>Add images to showcase this project.</p>
                </div>
            }

        </div>

    </section>

    @if (!string.IsNullOrWhiteSpace(Model.video_url))
    {
        <section class="section">
            <div class="section-label">PROJECT VIDEO</div>

            <a href="@Model.video_url"
               target="_blank"
               rel="noopener noreferrer">
                Watch Project Video →
            </a>
        </section>
    }

    <div class="project-actions mt-4">

        <a asp-action="Edit"
           asp-route-id="@Model.project_id">
            Edit Project
        </a>

        <a asp-action="Index">
            Back to Projects
        </a>

    </div>

</div>
