@model portfolio.Models.Project
@using portfolio.Models

@{
    ViewData["Title"] = Model.project_title;
    var course = ViewBag.Course as Course;
    var images = ViewBag.Images as List<ProjectImage>
                 ?? new List<ProjectImage>();
}

<div class="portfolio-page">

    <a asp-action="Index" class="back-link">← Back to Projects</a>

    <div class="details-header">
        <div class="section-label">PROJECT DETAILS</div>
        <h1>@Model.project_title</h1>

        @if (course != null)
        {
            <p>
                Course:
                <a asp-controller="Course"
                   asp-action="Details"
                   asp-route-id="@course.course_id">
                    @course.course_code — @course.course_name
                </a>
            </p>
        }
    </div>

    <section class="details-section">
        <h2>About This Project</h2>
        <p>@(Model.description ?? "No description provided.")</p>
    </section>

    <section class="details-section">
        <h2>Project Images</h2>

        @if (images.Any())
        {
            <div class="image-gallery">
                @foreach (var image in images)
                {
                    <article class="image-card">
                        <a asp-controller="ProjectImage"
                           asp-action="Details"
                           asp-route-id="@image.image_id">
                            <img src="@image.image_url"
                                 alt="@Model.project_title" />
                        </a>
                    </article>
                }
            </div>
        }
        else
        {
            <p>No images have been added to this project.</p>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.video_url))
    {
        <section class="details-section">
            <h2>Project Video</h2>
            <a href="@Model.video_url"
               target="_blank"
               rel="noopener noreferrer">
                Watch Project Video →
            </a>
        </section>
    }

    <div class="details-actions">
        <a asp-action="Edit"
           asp-route-id="@Model.project_id"
           class="btn-primary-custom">
            Edit Project
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.project_id"
           class="btn-danger-custom">
            Delete Project
        </a>
    </div>

</div>
