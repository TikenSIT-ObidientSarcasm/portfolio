@model portfolio.Models.Project

@{
    ViewData["Title"] = "Edit Project";
}

<div class="admin-page">
    <div class="admin-header">
        <div>
            <h1>Edit Project</h1>
            <p class="admin-subtitle">Update your project information.</p>
        </div>
    </div>

    <div class="admin-card">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="project_id" />

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="project_title">Project Title</label>
                <input asp-for="project_title" class="form-control" />
                <span asp-validation-for="project_title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="course_id">Course</label>
                <select asp-for="course_id"
                        asp-items="ViewBag.Courses"
                        class="form-select">
                    <option value="">-- Select a Course --</option>
                </select>
                <span asp-validation-for="course_id" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="description">Description</label>
                <textarea asp-for="description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="video_url">Video URL</label>
                <input asp-for="video_url" class="form-control" />
                <span asp-validation-for="video_url" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Add more images (optional, max 5 MB each)</label>
                <input type="file" name="imageFiles" class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" multiple />
                <small class="text-muted">
                    To remove existing images, use the Project Images page.
                </small>
            </div>

            <div class="form-actions">
                <button type="submit" class="admin-btn btn-primary-admin">
                    Save Changes
                </button>

                <a asp-action="Index" class="admin-btn btn-secondary-admin">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>