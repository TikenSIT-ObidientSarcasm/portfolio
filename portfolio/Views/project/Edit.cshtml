@model portfolio.Models.Project

@{
    ViewData["Title"] = "Edit Project";
}

<div class="admin-page">
    <div class="admin-header">
        <div>
            <h1>Edit Project</h1>
            <p class="admin-subtitle">Update your project information.</p>
        </div>
    </div>

    <div class="admin-card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="project_id" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="project_title">Project Title</label>
                <input asp-for="project_title" class="form-control" />
                <span asp-validation-for="project_title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="description">Description</label>
                <textarea asp-for="description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="video_url">Video URL</label>
                <input asp-for="video_url" class="form-control" />
                <span asp-validation-for="video_url" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="admin-btn btn-primary-admin">
                    Save Changes
                </button>

                <a asp-action="Index" class="admin-btn btn-secondary-admin">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
