@model List<portfolio.Models.Project>
@using portfolio.Models
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Projects";

    var courses = ViewBag.CourseLookup as Dictionary<long, Course>
                  ?? new Dictionary<long, Course>();

    var projectImages = ViewBag.ProjectImages as Dictionary<long, List<ProjectImage>>
                        ?? new Dictionary<long, List<ProjectImage>>();

    ViewBag.Courses = new SelectList(courses.Values, "course_id", "course_code");
}

<div class="portfolio-page">

    <section class="hero">
        <div class="eyebrow">ඞඞඞඞඞඞඞඞ</div>
        <h1>Projects Of Kharlsonn Virmar L. Tiken</h1>
        <p>
            ඞ Using Ai to refine my code :p.
        </p>
    </section>

    <section class="section">

        <div class="section-heading">
            <div>
                <div class="section-label">PORTFOLIO COLLECTION</div>
                <h2>All Projects</h2>
                <p class="text-muted mb-0 mt-2">
                    @(Model?.Count ?? 0) project(s) available
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="ProjectImage"
                   asp-action="Index"
                   class="btn-primary-custom">
                    Manage Images
                </a>

                <button type="button" class="btn-primary-custom"
                        data-bs-toggle="modal"
                        data-bs-target="#addProjectModal">
                    + Add Project
                </button>
            </div>
        </div>

        <div class="project-grid">

            @if (Model != null && Model.Any())
            {
                var number = 1;

                foreach (var project in Model)
                {
                    var course = courses.ContainsKey(project.course_id)
                        ? courses[project.course_id]
                        : null;

                    var images = projectImages.ContainsKey(project.project_id)
                        ? projectImages[project.project_id]
                        : new List<ProjectImage>();

                    var firstImage = images.FirstOrDefault();

                    <article class="project-card">

                        @if (firstImage != null)
                        {
                            <img class="project-card-image"
                                 src="@firstImage.image_url"
                                 alt="@project.project_title" />
                        }
                        else
                        {
                            <div class="project-card-placeholder">
                                PROJECT @number.ToString("00")
                            </div>
                        }

                        <div class="project-card-body">

                            <div class="project-number">
                                PROJECT / @number.ToString("00")
                            </div>

                            <h3>@project.project_title</h3>

                            @if (course != null)
                            {
                                <div class="project-course">
                                    @course.course_code
                                </div>
                            }

                            <p>
                                @(string.IsNullOrWhiteSpace(project.description)
                                    ? "No description provided."
                                    : project.description)
                            </p>

                            <div class="d-flex gap-2 flex-wrap mb-3">
                                @if (images.Count > 0)
                                {
                                    <span class="text-muted small">
                                        @images.Count image(s)
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(project.video_url))
                                {
                                    <span class="text-muted small">
                                        · Video available
                                    </span>
                                }
                            </div>

                            <div class="project-actions">
                                <a asp-action="Edit"
                                   asp-route-id="@project.project_id">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@project.project_id"
                                   class="delete-link">
                                    Delete
                                </a>
                            </div>

                        </div>
                    </article>

                    number++;
                }
            }
            else
            {
                <div class="empty-projects">
                    <h3>No projects yet</h3>
                    <p>Your added projects will appear here.</p>

                    <button type="button" class="btn-primary-custom"
                            data-bs-toggle="modal"
                            data-bs-target="#addProjectModal">
                        Add Your First Project
                    </button>
                </div>
            }

        </div>
    </section>
</div>


<!-- Add Project Modal -->
<div class="modal fade" id="addProjectModal" tabindex="-1"
     aria-labelledby="addProjectModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="addProjectModalLabel">
                    Add a Project
                </h5>

                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>  

            <div class="modal-body">
                <partial name="Create" model="new portfolio.Models.Project()" />
            </div>

        </div>
    </div>
</div>
