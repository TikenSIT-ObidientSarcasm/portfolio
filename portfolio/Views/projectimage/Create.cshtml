@model portfolio.Models.ProjectImage

@{
    ViewData["Title"] = "Add a project Image";
}

<h1 class="mb-3">Add a Project Image</h1>

<form asp-action="Create" method="post"
      class="card card-body" style="max-width:36rem">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="image_url" class="form-label">Image URL</label>
        <input asp-for="image_url" class="form-control"
               placeholder="e.g. https://example.com/image.jpg" />
        <span asp-validation-for="image_url" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
