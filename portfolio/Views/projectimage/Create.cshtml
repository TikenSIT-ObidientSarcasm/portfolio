@model portfolio.Models.ProjectImage

@{
    ViewData["Title"] = "Add Project Image";
}

<div class="portfolio-page">

    <section class="hero">
        <div class="eyebrow">PROJECT GALLERY</div>
        <h1>Add Image.</h1>
        <p>
            Add an image to showcase your project.
        </p>
    </section>

    <section class="section">

        <div class="section-heading">
            <div>
                <div class="section-label">NEW IMAGE</div>
                <h2>@ViewBag.ProjectTitle</h2>
            </div>
        </div>

        <form asp-controller="ProjectImage"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <input type="hidden" asp-for="project_id" />

            <div class="mb-4">
                <label asp-for="image_url"
                       class="form-label">
                    Image URL
                </label>

                <input asp-for="image_url"
                       class="form-control"
                       placeholder="https://example.com/image.jpg" />

                <span asp-validation-for="image_url"
                      class="text-danger"></span>
            </div>

            <div class="project-actions">

                <button type="submit"
                        class="btn-primary-custom">
                    Save Image
                </button>

                <a asp-controller="Project"
                   asp-action="Details"
                   asp-route-id="@Model.project_id">
                    Cancel
                </a>

            </div>

        </form>

    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
