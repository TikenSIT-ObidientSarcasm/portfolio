@model portfolio.Models.ProjectImage

@{
    ViewData["Title"] = "Add a Project Image";
}

<div class="page">
    <h1 class="mb-3">Add a Project Image</h1>

    <form asp-action="Create" method="post"
          class="card card-body" style="max-width:36rem">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="project_id" class="form-label">Project</label>
            <select asp-for="project_id"
                    asp-items="ViewBag.Projects"
                    class="form-select">
                <option value="">-- Select a Project --</option>
            </select>
            <span asp-validation-for="project_id" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="image_url" class="form-label">Image URL</label>
            <input asp-for="image_url" class="form-control"
                   placeholder="https://example.com/image.jpg" />
            <span asp-validation-for="image_url" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save Image</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
