@model portfolio.Models.ProjectImage

@{
    ViewData["Title"] = "Delete Image";
    var project = ViewBag.Project as portfolio.Models.Project;
}

<div class="container py-4">
    <h1>Delete Image</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <p>Are you sure you want to delete this image?</p>

    @if (project != null)
    {
        <p class="text-muted">Project: @project.project_title</p>
    }

    <img src="@Model.image_url" alt="Preview"
         style="max-width: 250px;" class="mb-3 d-block" />

    <form asp-action="Delete" asp-route-id="@Model.image_id" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>