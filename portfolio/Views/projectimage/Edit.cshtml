@model portfolio.Models.ProjectImage

@{
    ViewData["Title"] = "Edit a Project Image";
}

<h1 class="mb-3">Edit a Project Image</h1>

<form asp-action="Edit" method="post"
      class="card card-body" style="max-width:36rem">

    <input type="hidden" asp-for="image_id" />

    <div class="mb-3">
        <label asp-for="image_url" class="form-label">Image URL</label>
        <input asp-for="image_url" class="form-control" />
        <span asp-validation-for="image_url" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
