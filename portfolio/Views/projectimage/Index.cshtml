@model IEnumerable<portfolio.Models.ProjectImage>

@{
    ViewData["Title"] = "Project Images";
    var images = Model?.ToList() ?? new List<portfolio.Models.ProjectImage>();
}

<div class="portfolio-page">

    <section class="hero">
        <div class="eyebrow">MEDIA ARCHIVE</div>
        <h1>Project Images.</h1>
        <p>All uploaded project images. Upload new ones from Add Project or Edit Project.</p>
    </section>

    <section class="section">

        <div class="section-heading">
            <div>
                <div class="section-label">IMAGE LIBRARY</div>
                <h2>All Images</h2>
                <p class="text-muted mb-0 mt-2">
                    @images.Count image(s) stored
                </p>
            </div>

            <a asp-controller="Project" asp-action="Index"
               class="btn-primary-custom">
                Back to Projects
            </a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="image-gallery">

            @if (images.Any())
            {
                foreach (var item in images)
                {
                    <article class="image-card">

                        <img src="@item.image_url"
                             alt="Image @item.image_id of project @item.project_id" />

                        <div class="image-card-info">
                            <div class="project-number">
                                PROJECT ID / @item.project_id
                            </div>

                            <div class="project-actions">
                                <button type="button"
                                        class="delete-link"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteImageModal-@item.image_id">
                                    Delete
                                </button>
                            </div>
                        </div>

                    </article>
                }
            }
            else
            {
                <div class="empty-projects">
                    <h3>No images yet</h3>
                    <p>Images you upload to a project will appear here.</p>
                </div>
            }

        </div>
    </section>
</div>

@* ===== DELETE POPUPS ===== *@
@foreach (var item in images)
{
    <div class="modal fade" id="deleteImageModal-@item.image_id"
         tabindex="-1"
         aria-labelledby="deleteImageLabel-@item.image_id"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="deleteImageLabel-@item.image_id">
                        Delete Image
                    </h5>

                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <img src="@item.image_url" alt="Preview"
                         class="mb-3"
                         style="width:100%; max-height:260px; object-fit:contain; background:var(--iron); border:1px solid var(--brass);" />

                    <p>Are you sure you want to delete this image?</p>

                    <p class="text-muted small mb-0">
                        It is removed from project @item.project_id and from
                        storage. This cannot be undone.
                    </p>
                </div>

                <div class="modal-footer">
                    <form asp-controller="ProjectImage" asp-action="Delete"
                          asp-route-id="@item.image_id" method="post">

                        <button type="button" class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" class="btn btn-danger">
                            Delete
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
}